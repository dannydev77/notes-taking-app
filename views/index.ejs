<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= currentNotebook ? `${currentNotebook} - ` : '' %>Note Taking App</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="container">
    <h1>
      <%= currentNotebook ? `${currentNotebook} Notebook` : 'My Notes' %>
      <% if (currentNotebook) { %>
        <span class="notebook-badge"><%= currentNotebook %></span>
      <% } %>
    </h1>
    
    <div class="toolbar">
      <div class="toolbar-left">
        <a href="/notes/new" class="btn">Create New Note</a>
        <a href="/notebooks" class="btn">Manage Notebooks</a>
      </div>
      
      <form action="/" method="GET" class="search-form">
        <input type="hidden" name="notebook" value="<%= currentNotebook %>">
        <input type="text" name="search" placeholder="Search notes..." value="<%= searchQuery %>">
        <button type="submit" class="btn">Search</button>
        <a href="/?notebook=<%= currentNotebook %>" class="btn secondary">Clear</a>
      </form>
    </div>
    
    <div class="filters">
      <% if (notebooks.length > 0) { %>
        <div class="filter-group">
          <h3>Notebooks</h3>
          <ul>
            <li><a href="/" class="<%= !currentNotebook ? 'active' : '' %>">All Notes</a></li>
            <% notebooks.forEach(notebook => { %>
              <li>
                <a href="/?notebook=<%= encodeURIComponent(notebook) %>" 
                   class="<%= currentNotebook === notebook ? 'active' : '' %>">
                  <%= notebook %>
                </a>
              </li>
            <% }) %>
          </ul>
        </div>
      <% } %>
      
      <% if (categories.length > 0) { %>
        <div class="filter-group">
          <h3>Categories</h3>
          <ul>
            <li><a href="/?notebook=<%= currentNotebook %>" class="<%= !selectedCategory ? 'active' : '' %>">All</a></li>
            <% categories.forEach(category => { %>
              <li>
                <a href="/?notebook=<%= currentNotebook %>&category=<%= encodeURIComponent(category) %>" 
                   class="<%= selectedCategory === category ? 'active' : '' %>">
                  <%= category %>
                </a>
              </li>
            <% }) %>
          </ul>
        </div>
      <% } %>
      
      <% if (tags.length > 0) { %>
        <div class="filter-group">
          <h3>Tags</h3>
          <ul>
            <li><a href="/?notebook=<%= currentNotebook %>" class="<%= !selectedTag ? 'active' : '' %>">All</a></li>
            <% tags.forEach(tag => { %>
              <li>
                <a href="/?notebook=<%= currentNotebook %>&tag=<%= encodeURIComponent(tag) %>" 
                   class="<%= selectedTag === tag ? 'active' : '' %>">
                  #<%= tag %>
                </a>
              </li>
            <% }) %>
          </ul>
        </div>
      <% } %>
    </div>
    
    <% if (notes.length === 0) { %>
      <p>No notes found. Create your first note!</p>
    <% } else { %>
      <ul class="note-list">
        <% notes.forEach(note => { %>
          <li>
            <a href="/notes/<%= note.id %>">
              <h3><%= note.title %></h3>
              <div class="meta">
                <span class="date"><%= new Date(note.createdAt).toLocaleString() %></span>
                <% if (note.updatedAt !== note.createdAt) { %>
                  <span class="date">(updated <%= new Date(note.updatedAt).toLocaleString() %>)</span>
                <% } %>
                <% if (note.notebook) { %>
                  <span class="notebook"><%= note.notebook %></span>
                <% } %>
              </div>
              <% if (note.attachments && note.attachments.length > 0) { %>
                <div class="attachments-badge">
                  <%= note.attachments.length %> attachment<%= note.attachments.length !== 1 ? 's' : '' %>
                </div>
              <% } %>
              <% if (note.categories && note.categories.length > 0) { %>
                <div class="categories">
                  <% note.categories.forEach(category => { %>
                    <span class="category"><%= category %></span>
                  <% }) %>
                </div>
              <% } %>
              <% if (note.tags && note.tags.length > 0) { %>
                <div class="tags">
                  <% note.tags.forEach(tag => { %>
                    <span class="tag">#<%= tag %></span>
                  <% }) %>
                </div>
              <% } %>
            </a>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>
</body>
</html>