<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= note ? 'Edit' : 'New' %> Note</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="container">
    <h1><%= note ? 'Edit Note' : 'Create New Note' %></h1>
    
    <form action="<%= note ? `/notes/${id}` : '/notes' %>" method="POST" enctype="multipart/form-data">
      <% if (note) { %>
        <input type="hidden" name="createdAt" value="<%= note.createdAt %>">
      <% } %>
      
      <div class="form-group">
        <label for="notebook">Notebook (optional)</label>
        <select id="notebook" name="notebook">
          <option value="">-- No Notebook --</option>
          <% notebooks.forEach(notebook => { %>
            <option value="<%= notebook %>" <%= note && note.notebook === notebook ? 'selected' : '' %>>
              <%= notebook %>
            </option>
          <% }) %>
        </select>
      </div>
      
      <div class="form-group">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" value="<%= note ? note.title : '' %>" required>
      </div>
      
      <div class="form-group">
        <label for="content">Content (Markdown supported)</label>
        <textarea id="content" name="content" rows="10" required><%= note ? note.content : '' %></textarea>
      </div>
      
      <div class="form-group">
        <label for="categories">Categories (comma separated)</label>
        <input type="text" id="categories" name="categories" 
               value="<%= note && note.categories ? note.categories.join(', ') : '' %>">
      </div>
      
      <div class="form-group">
        <label for="tags">Tags (comma separated, without #)</label>
        <input type="text" id="tags" name="tags" 
               value="<%= note && note.tags ? note.tags.join(', ') : '' %>">
      </div>
      
      <div class="form-group">
        <label for="attachments">Attachments (max 5 files)</label>
        <input type="file" id="attachments" name="attachments" multiple>
      </div>
      
      <% if (note && note.attachments && note.attachments.length > 0) { %>
        <div class="form-group">
          <label>Existing Attachments</label>
          <ul class="attachments-list">
            <% note.attachments.forEach(attachment => { %>
              <li>
                <a href="<%= attachment.path %>" target="_blank"><%= attachment.name %></a>
                <a href="/notes/<%= id %>/attachments/<%= attachment.path.split('/').pop() %>/delete" 
                   class="btn danger small">Delete</a>
              </li>
            <% }) %>
          </ul>
        </div>
      <% } %>
      
      <input type="hidden" id="pastedImages" name="pastedImages" value="">
      
      <div class="actions">
        <button type="submit" class="btn">Save</button>
        <a href="<%= note ? `/notes/${id}` : '/' %>" class="btn secondary">Cancel</a>
      </div>
    </form>
    
    <div class="markdown-preview">
      <h3>Preview</h3>
      <div id="preview-content"></div>
    </div>
  </div>

  <script src="/js/clipboard.js"></script>
  <script>
    // Handle pasted images
    const contentTextarea = document.getElementById('content');
    const pastedImagesInput = document.getElementById('pastedImages');
    const pastedImages = [];
    
    contentTextarea.addEventListener('paste', function(e) {
      const items = (e.clipboardData || e.originalEvent.clipboardData).items;
      
      for (let i = 0; i < items.length; i++) {
        if (items[i].type.indexOf('image') !== -1) {
          const blob = items[i].getAsFile();
          const reader = new FileReader();
          
          reader.onload = function(event) {
            const placeholder = `[pasted-image-${Date.now()}]`;
            pastedImages.push({
              placeholder,
              data: event.target.result
            });
            
            // Insert placeholder in text
            const cursorPos = contentTextarea.selectionStart;
            const textBefore = contentTextarea.value.substring(0, cursorPos);
            const textAfter = contentTextarea.value.substring(cursorPos);
            contentTextarea.value = textBefore + placeholder + textAfter;
            
            // Update hidden field
            pastedImagesInput.value = JSON.stringify(pastedImages);
            
            // Update preview
            updatePreview();
          };
          
          reader.readAsDataURL(blob);
          e.preventDefault();
        }
      }
    });
    
    // Live Markdown preview
    function updatePreview() {
      let content = contentTextarea.value;
      
      // Replace image placeholders in preview
      pastedImages.forEach(img => {
        content = content.replace(img.placeholder, `![pasted image](${img.data})`);
      });
      
      document.getElementById('preview-content').innerHTML = marked.parse(content);
    }
    
    contentTextarea.addEventListener('input', updatePreview);
    updatePreview();
  </script>
</body>
</html>